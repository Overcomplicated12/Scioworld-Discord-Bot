{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scioworld-discord-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scio-world-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
