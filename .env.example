DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: use a testing server for immediate command updates.
# When set, deployment registers commands in this guild for fast testing.
DISCORD_GUILD_ID=
# Optional: set true only after enabling Message Content Intent in the Discord Developer Portal.
DISCORD_MESSAGE_CONTENT=false
# Optional and destructive: set to true only to intentionally clear global commands.
DISCORD_CLEAR_GLOBAL_COMMANDS=false
